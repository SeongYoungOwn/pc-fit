PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-secret-in-production
CLIENT_URL=http://localhost:8080

# Supabase Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# AI Gateway / LLM API
OPENAI_API_KEY=your_ai_api_key
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/openai
# Optional: Direct Gemini Search Grounding
GEMINI_API_KEY=

# Naver OpenAPI (Image & Shopping Search)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# TechSpecs v5: server only. Never use VUE_APP_* for these credentials.
TECHSPECS_API_ID=
TECHSPECS_API_KEY=
# Enable only after confirming permission to store TechSpecs data.
TECHSPECS_STORAGE_ALLOWED=false

# Optional persistent location for the free BuildCores SQLite catalog (Node.js 22.13+).
# Default: back/.local/parts-catalog.sqlite. Keep this file outside Git.
PARTS_CATALOG_PATH=
